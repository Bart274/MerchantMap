# Copy to .env and fill in real values.

# Which map renderer to serve: 'google' or 'leaflet' (free, no API key).
MERCHANTMAP_MAP_PROVIDER=google

# Google Maps JavaScript API key. Required unless MERCHANTMAP_MAP_PROVIDER is 'leaflet'.
MERCHANTMAP_GMAPS_KEY=

# Required: starting location, an address or "lat,lng" coordinates.
MERCHANTMAP_LOCATION=

# Optional: hostname used for external requests, e.g. https://map.example.com
MERCHANTMAP_EXTERNAL_HOSTNAME=http://127.0.0.1:5050

# Optional: host-side port to publish the app on (default 5050). Not 5000 -
# macOS AirPlay Receiver often already holds that port.
MERCHANTMAP_HOST_PORT=5050

# MySQL credentials, shared between the db and app services.
MYSQL_DATABASE=merchantmap
MYSQL_USER=merchantmap
MYSQL_PASSWORD=merchantmap
